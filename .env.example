# The first-party privacy-request queue stays unavailable until its migration,
# owner, fallback mailbox, monitoring, and operating procedure are verified.
PRIVACY_REQUEST_INTAKE_ENABLED="false"
PRIVACY_REQUEST_EMAIL=""
PRIVACY_REQUEST_MONITOR_ENABLED="false"
# The private operator lifecycle remains unavailable until its schema, access
# path, synthetic evidence, and action-time production approval are complete.
PRIVACY_REQUEST_OPERATIONS_ENABLED="false"
# No executable runner or production binding exists. A future local/server
# operator command must separately require this exact opt-in gate.
PRIVACY_REQUEST_OPERATOR_RUNNER_ENABLED="false"
# Scheduled privacy retention is inert until this exact switch is enabled.
CAPITOLWONK_PRIVACY_RETENTION_SWEEP_ENABLED="false"
# Legacy BetaFeedback erasure requires separate export/migration approval.
CAPITOLWONK_LEGACY_FEEDBACK_RETENTION_ENABLED="false"

