{
  "contractVersion": "2026-09-14",
  "decisionStatus": "pure_verifiers_only_locally_validated",
  "productionExecutionAuthorized": false,
  "artifactDeletion": {
    "artifactKinds": [
      "mailbox_message_and_duplicate_copies",
      "mailbox_attachment",
      "export_artifact_and_access_token"
    ],
    "retention": {
      "mailboxMessageDaysAfterResolution": 30,
      "mailboxAttachmentDaysAfterClassification": 7,
      "exportArtifactHoursAfterCreation": 168,
      "exportConfirmedRetrievalExpiresImmediately": true
    },
    "requiredEvidence": [
      "closed_artifact_kind",
      "lifecycle_anchor_timestamp",
      "deletion_deadline_timestamp",
      "deletion_confirmation_timestamp",
      "zero_remaining_artifact_copies",
      "zero_remaining_access_tokens_for_export"
