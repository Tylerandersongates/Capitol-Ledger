      "provider_identifier",
      "credential",
      "raw_error"
    ],
    "deletionCapabilityImplemented": false,
    "providerBindingImplemented": false
  },
  "restoreFloor": {
    "sourcePolicy": "constrained_restore_floor",
    "unsafeDecision": "reject",
    "safeDecision": "eligible_for_further_recovery_review",
    "eligibleAuthorizesTrafficSwitch": false,
    "serviceStateForEveryDecision": "keep_offline",
    "rejectWhen": [
