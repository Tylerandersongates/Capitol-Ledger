{
  "name": "capitol-ledger",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "node scripts/check-local-preview-runtime.mjs && next dev",
    "dev:preview": "node scripts/check-local-preview-runtime.mjs && next dev -H 127.0.0.1 -p 3023",
    "dev:wasm": "node scripts/check-local-preview-runtime.mjs && NODE_OPTIONS='--require ./scripts/force-swc-wasm.cjs' next dev",
    "build": "prisma generate && next build",
    "build:wasm": "prisma generate && NODE_OPTIONS='--require ./scripts/force-swc-wasm.cjs' next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "production-auth:check": "node scripts/check-production-auth.mjs",
    "production-auth:qa": "node scripts/qa-production-auth.mjs",
    "team:qa": "node scripts/qa-team-flow.mjs",
    "team-invite-billing:check": "node --import tsx scripts/check-team-invite-apple-billing.ts",
    "auth-email:check": "node scripts/check-auth-email-delivery.mjs",
    "weekly-brief:check": "node scripts/check-weekly-brief-delivery.mjs",
    "weekly-brief:in-app-check": "node scripts/check-weekly-brief-in-app.mjs && node --import tsx scripts/check-daily-brief-video.ts && node --import tsx scripts/check-weekly-brief-editorial-fixtures.ts && node --import tsx scripts/check-weekly-brief-daily-editions.ts",
    "weekly-brief:qa": "node scripts/qa-weekly-brief-task.mjs",
    "billing:check": "node scripts/check-billing-readiness.mjs && node --import tsx scripts/check-app-store-subscription-fixtures.ts && node --import tsx scripts/check-app-store-state-fixtures.ts && node --import tsx scripts/check-app-store-relink-fixtures.ts",
    "billing-legacy:audit": "tsx scripts/audit-legacy-billing-state.ts",
    "billing-transition:check": "node --import tsx scripts/check-billing-transition-fixtures.mjs",
    "ios-native:check": "node scripts/check-ios-native-bridge.mjs",
    "testflight-ui:check": "node scripts/check-testflight-mobile-ui.mjs",
    "launch-copy:check": "node scripts/check-launch-copy-tone.mjs",
    "brand:check": "tsx scripts/check-public-brand.ts",
    "testflight:check": "node scripts/check-testflight-readiness.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "audit:full": "pnpm audit --audit-level high",
    "release-source:check": "pnpm run billing:check && pnpm run billing-transition:check && pnpm run team-invite-billing:check && pnpm run privacy-retention:check && pnpm run account-deletion:check && pnpm run ios-native:check && pnpm run testflight-ui:check && pnpm run testflight:check && pnpm run launch-copy:check && pnpm run dashboard-blank-state:check && pnpm run search-live-fallback:check",
    "release-candidate:check": "pnpm run audit:prod && pnpm run audit:full && BILLING_REQUIRE_APP_STORE=true TESTFLIGHT_REQUIRE_READY=true pnpm run release-source:check",
    "account-deletion:check": "node --import tsx scripts/check-account-deletion-activation-fixtures.ts && node --import tsx scripts/check-account-deletion-fixtures.ts && node --import tsx scripts/check-account-deletion-cleanup-fixtures.ts && node --import tsx scripts/check-account-persistence-safety.ts && node scripts/check-account-deletion-readiness.mjs",
    "account-persistence:check": "node --import tsx scripts/check-account-persistence-safety.ts",
    "policy-edge:check": "node scripts/check-policy-edge-routes.mjs && node scripts/check-policy-edge-feed.mjs",
    "live-docket:check": "node scripts/check-live-docket-route.mjs",
    "search-filters:check": "node scripts/check-search-filter-collapse.mjs",
    "search-results:check": "node scripts/check-search-results-scroll.mjs",
    "search-state:check": "node scripts/check-search-saved-official-state.mjs",
    "bill-status:check": "node scripts/check-bill-law-status.mjs",
    "dashboard-blank-state:check": "node scripts/check-dashboard-blank-state.mjs",
    "search-live-fallback:check": "node scripts/check-search-live-fallback.mjs",
    "bill-actions:check": "node scripts/check-bill-action-log.mjs",
    "bill-details:check": "node scripts/check-bill-details-summary.mjs",
    "member-service:check": "node scripts/check-member-service-history.mjs",
    "member-votes:check": "node scripts/check-member-vote-records.mjs",
    "member-roles:check": "node scripts/check-member-roles.mjs",
    "member-profile:check": "node scripts/check-member-profile-actions.mjs",
    "member-issues:check": "node scripts/check-member-issue-topics.mjs",
    "member-accountability:check": "tsx scripts/check-member-accountability-score.ts",
    "bill-timeline:check": "node scripts/check-bill-timeline.mjs",
    "bill-votes:check": "node scripts/check-bill-vote-history.mjs",
    "vote-positions:check": "node scripts/check-vote-positions-scroll.mjs",
    "gamification:check": "node scripts/check-gamification-streak.mjs",
    "election-participation:check": "node scripts/check-election-participation-copy.mjs",
    "backend:check": "node scripts/check-backend-readiness.mjs",
    "ai-policy-lens:check": "tsx scripts/check-ai-policy-lens-fixtures.ts",
    "ai-bill-analysis:live-check": "tsx scripts/check-ai-bill-analysis-live.ts",
    "video-links:check": "node scripts/check-video-links.mjs",
    "youtube-statements:sync": "tsx scripts/sync-youtube-bill-statements.ts",
    "youtube-statements:check": "node scripts/check-youtube-bill-statements.mjs",
    "feedback:check": "node scripts/check-feedback-readiness.mjs",
    "privacy-retention:check": "node --import tsx scripts/check-privacy-retention-fixtures.ts",
    "local-preview:check": "node scripts/check-local-preview-runtime.mjs",
    "congress:check": "node scripts/check-congress-readiness.mjs",
    "congress-roster:check": "tsx scripts/check-congress-member-roster.ts",
    "congress-roster:audit": "tsx scripts/audit-congress-roster-data-quality.ts",
    "congress-bills:check": "tsx scripts/check-congress-bill-catalog.ts",
    "congress-votes:check": "tsx scripts/check-congress-vote-catalog.ts",
    "db:seed": "prisma db seed",
    "sync:congress": "tsx scripts/sync-congress.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@prisma/client": "^5.14.0",
    "@sentry/nextjs": "10.69.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "prisma": "^5.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "15.5.25",
    "@types/node": "^20.12.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "overrides": {
      "next@15.5.25>postcss": "8.5.25"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
